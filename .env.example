# Copy to .env and fill in (see docs/hosting.md). Never commit .env.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@HOST:5432/postgres"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@HOST:5432/postgres"
# INLINE_WORKER=1   # default in development: run background jobs inside `shopify app dev`
META_APP_ID=""
META_APP_SECRET=""
# ENCRYPTION_KEY=""   # optional; defaults to a key derived from SHOPIFY_API_SECRET
